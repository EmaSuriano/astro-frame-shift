---
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import path from 'path';

interface Props {
  title: string;
}

const { title } = Astro.props;
const { BASE_URL } = import.meta.env;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href={path.join(BASE_URL, 'favicon.svg')}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Dark-first theme init — respect stored preference, else default dark
      (function () {
        const root = document.documentElement;
        const stored =
          typeof localStorage !== 'undefined'
            ? localStorage.getItem('theme')
            : null;
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';

        root.classList.toggle('dark', theme === 'dark');
        root.classList.toggle('light', theme === 'light');
        root.style.colorScheme = theme;
        if (typeof localStorage !== 'undefined') {
          localStorage.setItem('theme', theme);
        }
      })();
    </script>
    <style>
      /* Custom styles for masonry layout */
      .masonry-container {
        column-gap: 1.5rem;
      }
      .masonry-item {
        display: inline-block;
        width: 100%;
      }
    </style>
    <ClientRouter />
  </head>
  <body
    class="min-h-screen flex flex-col bg-paper font-sans text-ink antialiased transition-colors duration-300"
    transition:animate="initial"
  >
    <div class="fixed top-6 right-6 z-20">
      <ThemeToggle />
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <footer
      class="mt-16 bg-paper-2 py-8"
      transition:name="footer"
    >
      <div
        class="container mx-auto px-6 text-center text-sm font-light text-muted"
      >
        <p>
          &copy; {new Date().getFullYear()}{' '}
          <a
            href="https://github.com/EmaSuriano"
            class="transition-colors hover:text-ink"
          >
            Ema Suriano
          </a>
        </p>
        <p class="mt-2">
          <a
            href="https://github.com/EmaSuriano/astro-frame-shift"
            class="transition-colors hover:text-ink"
          >
            Astro Frame Shift
          </a>
          {' · Built with '}
          <a
            href="https://astro.build"
            class="transition-colors hover:text-ink"
          >
            Astro
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
