---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CategoryFilters from '../../components/CategoryFilters.astro';
import GalleryMasonry from '../../components/GalleryMasonry.astro';
import { categoriesOf } from '../../utils/categories';
import { slugify } from '../../utils/slug';

export async function getStaticPaths() {
  const collection = await getCollection('gallery');
  const images = collection.map((a) => ({ ...a.data, id: a.id }));
  const allCategories = [
    ...new Set(images.flatMap((img) => categoriesOf(img))),
  ].sort((a, b) => a.localeCompare(b));

  return allCategories.map((category) => {
    const slug = slugify(category);
    const filtered = images.filter((img) =>
      categoriesOf(img).some((c) => slugify(c) === slug),
    );
    return {
      params: { category: slug },
      props: { category, images: filtered, allCategories },
    };
  });
}

const { category, images, allCategories } = Astro.props;
---

<Layout title={`${category} | Image Gallery`}>
  <main class="container mx-auto px-6 py-16">
    <h1
      class="font-display text-5xl font-normal tracking-wide mb-8 text-stone-900 dark:text-stone-100"
    >
      Gallery
    </h1>

    <CategoryFilters categories={allCategories} active={slugify(category)} />
    <GalleryMasonry images={images} />
  </main>
</Layout>
