---
import 'photoswipe/style.css';
---

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const CHILDREN_SELECTOR =
    '.masonry-item:not(.is-filtered-out) a.pswp-item, a.pswp-hero';

  let lightbox: PhotoSwipeLightbox | undefined;

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function bindPhotoSwipe() {
    lightbox?.destroy();

    lightbox = new PhotoSwipeLightbox({
      gallery: '.pswp-gallery',
      children: CHILDREN_SELECTOR,
      pswpModule: () => import('photoswipe'),
      paddingFn: () => ({ top: 24, bottom: 72, left: 16, right: 16 }),
    });

    lightbox.addFilter('domItemData', (itemData, element, linkEl) => {
      const img = (linkEl ?? element)?.querySelector?.('img');
      if (img instanceof HTMLImageElement && img.naturalWidth && img.naturalHeight) {
        itemData.width = img.naturalWidth;
        itemData.height = img.naturalHeight;
        itemData.w = img.naturalWidth;
        itemData.h = img.naturalHeight;
      }
      return itemData;
    });

    lightbox.on('uiRegister', () => {
      lightbox?.pswp?.ui.registerElement({
        name: 'custom-caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        html: '',
        onInit: (el) => {
          lightbox?.pswp?.on('change', () => {
            const slideEl = lightbox?.pswp?.currSlide?.data?.element;
            if (!(slideEl instanceof HTMLElement)) {
              el.innerHTML = '';
              return;
            }
            const title = slideEl.dataset.captionTitle ?? '';
            const categories = slideEl.dataset.captionCategories ?? '';
            const url = slideEl.dataset.captionUrl ?? '';
            const parts: string[] = [];
            if (title) {
              parts.push(`<strong>${escapeHtml(title)}</strong>`);
            }
            if (categories) {
              parts.push(`<span>${escapeHtml(categories)}</span>`);
            }
            if (url) {
              parts.push(
                `<a href="${escapeHtml(url)}">View details</a>`,
              );
            }
            el.innerHTML = parts.join(' · ');
          });
        },
      });
    });

    lightbox.init();
  }

  bindPhotoSwipe();
  document.addEventListener('astro:after-swap', bindPhotoSwipe);
  document.addEventListener('astro:before-swap', () => {
    lightbox?.destroy();
    lightbox = undefined;
  });
</script>

<style is:global>
  .pswp__custom-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.5rem 1.25rem 1.25rem;
    color: #f5f5f4;
    font-size: 0.95rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    background: linear-gradient(transparent, rgba(15, 23, 42, 0.75));
  }
  .pswp__custom-caption a {
    color: #e7e5e4;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
