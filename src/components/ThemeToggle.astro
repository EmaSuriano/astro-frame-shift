<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="inline-flex size-10 items-center justify-center rounded-full bg-paper-2 text-ink transition-colors duration-200 hover:opacity-90"
>
  <!-- Sun icon for dark mode (shown when in dark mode) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="hidden h-5 w-5 dark:block"
    viewBox="0 0 20 20"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      clip-rule="evenodd"></path>
  </svg>
  <!-- Moon icon for light mode (shown when in light mode) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="block h-5 w-5 dark:hidden"
    viewBox="0 0 20 20"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
    ></path>
  </svg>
</button>

<script>
  function setupThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    if (!themeToggle) return;

    themeToggle.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.classList.contains('dark') ? 'light' : 'dark';
      root.classList.toggle('dark', next === 'dark');
      root.classList.toggle('light', next === 'light');
      root.style.colorScheme = next;
      localStorage.setItem('theme', next);
    });
  }

  // Setup on initial load
  setupThemeToggle();

  // Handle reattaching event listeners on page navigation
  function applyTheme(root, theme) {
    const next = theme === 'light' ? 'light' : 'dark';
    root.classList.toggle('dark', next === 'dark');
    root.classList.toggle('light', next === 'light');
    root.style.colorScheme = next;
  }

  document.addEventListener('astro:after-swap', () => {
    applyTheme(document.documentElement, localStorage.getItem('theme'));
    setupThemeToggle();
  });

  document.addEventListener('astro:before-swap', (ev) => {
    applyTheme(ev.newDocument.documentElement, localStorage.getItem('theme'));
  });
</script>
