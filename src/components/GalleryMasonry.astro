---
import { Image } from 'astro:assets';
import path from 'path';
import { formatCategories } from '../utils/categories';

interface ImageItem {
  id: string;
  src: string;
  alt: string;
  title: string;
  categories?: string[];
  category?: string;
}

interface Props {
  images: ImageItem[];
}

const { images } = Astro.props;
const { BASE_URL } = import.meta.env;
---

<div class="pswp-gallery masonry-container columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-6 space-y-6">
  {
    images.map((image) => {
      const detailUrl = path.join(BASE_URL, 'image', image.id);
      return (
      <div class="masonry-item break-inside-avoid mb-6">
        <a
          href={detailUrl}
          class="pswp-item group block overflow-hidden rounded-lg transition-all duration-300 relative cursor-zoom-in"
          transition:name={`image-${image.id}`}
          data-pswp-src={image.src}
          data-pswp-width="1600"
          data-pswp-height="1200"
          data-pswp-cropped="true"
          data-caption-title={image.title}
          data-caption-categories={formatCategories(image)}
          data-caption-url={detailUrl}
        >
          <div class="overflow-hidden relative">
            <Image
              src={image.src}
              alt={image.alt}
              width="800"
              height="800"
              class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-102"
            />
            <div class="absolute inset-0 bg-slate-900 opacity-0 group-hover:opacity-50 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
              <div class="text-stone-100 text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-4">
                <h3 class="text-lg font-medium mb-1">{image.title}</h3>
                <p class="text-sm font-light tracking-wide opacity-90">
                  {formatCategories(image)}
                </p>
              </div>
            </div>
          </div>
        </a>
      </div>
      );
    })
  }
</div>
