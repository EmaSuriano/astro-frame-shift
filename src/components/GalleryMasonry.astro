---
import { Image } from 'astro:assets';
import path from 'path';
import { formatCategories } from '../utils/categories';

interface ImageItem {
  id: string;
  src: string;
  alt: string;
  title: string;
  categories?: string[];
  category?: string;
}

interface Props {
  images: ImageItem[];
}

const { images } = Astro.props;
const { BASE_URL } = import.meta.env;
---

<div class="masonry-container columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-6 space-y-6">
  {
    images.map((image, index) => (
      <div class="masonry-item break-inside-avoid mb-6">
        <a
          href={path.join(BASE_URL, 'image', image.id)}
          class="group block overflow-hidden rounded-lg relative transition-shadow duration-300 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500"
          transition:name={`image-${image.id}`}
        >
          <div class="overflow-hidden relative">
            <Image
              src={image.src}
              alt={image.alt}
              width="800"
              height="800"
              class="w-full h-auto object-cover"
              loading={index < 6 ? 'eager' : 'lazy'}
              fetchpriority={index < 2 ? 'high' : undefined}
              decoding="async"
            />
            {/* Always-visible caption for touch + keyboard; hover only deepens the scrim */}
            <div
              class="gallery-caption pointer-events-none absolute inset-x-0 bottom-0 px-3 pb-3 pt-10"
            >
              <h3 class="text-sm font-medium text-stone-50 md:text-base">
                {image.title}
              </h3>
              <p class="mt-0.5 text-xs font-light tracking-wide text-stone-200/90 md:text-sm">
                {formatCategories(image)}
              </p>
            </div>
          </div>
        </a>
      </div>
    ))
  }
</div>

<style>
  .gallery-caption {
    background: linear-gradient(
      to top,
      var(--color-overlay, oklch(18% 0.02 65 / 0.7)) 0%,
      transparent 100%
    );
  }
</style>
