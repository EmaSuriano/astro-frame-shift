---
import path from 'path';
import { slugify } from '../utils/slug';

interface Props {
  categories: string[];
  active: string | 'all';
}

const { categories, active } = Astro.props;
const { BASE_URL } = import.meta.env;
const chipClass =
  'category-chip px-3 py-1 text-sm font-light tracking-wide rounded-full border border-stone-300 dark:border-slate-600 text-stone-600 dark:text-slate-400 hover:text-stone-900 dark:hover:text-stone-200 transition-colors duration-300';
---

<nav id="category-filters" class="flex flex-wrap gap-2 mb-12" aria-label="Filter by category">
  <a
    href={BASE_URL}
    class:list={[chipClass, { 'is-active': active === 'all' }]}
  >
    All
  </a>
  {
    categories.map((category) => {
      const slug = slugify(category);
      return (
        <a
          href={path.join(BASE_URL, 'category', slug)}
          class:list={[chipClass, { 'is-active': active === slug }]}
        >
          {category}
        </a>
      );
    })
  }
</nav>

<style>
  .category-chip.is-active {
    background-color: #e7e5e4;
    color: #1c1917;
    border-color: #a8a29e;
  }
  :global(.dark) .category-chip.is-active {
    background-color: #334155;
    color: #f5f5f4;
    border-color: #64748b;
  }
</style>
